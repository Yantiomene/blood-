# Server
PORT=
SERVER_URL=
CLIENT_URL=
SECRET=

# Mailer
EMAIL=
PASSWORD=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Database
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Cache (optional but recommended)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Admins (comma-separated list of admin emails)
ADMIN_EMAILS=

# AI provider (DeepSeek) configuration
# Get an API key from https://platform.deepseek.com/ and choose the correct endpoint for your region.
DEEPSEEK_API_KEY=
# Optional: override endpoint; if unset, server will try .com then .cn domains.
DEEPSEEK_API_URL=
# Optional: model name (defaults to deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# AI provider (Gemini) configuration — preferred
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: model name (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# CI trigger: do not remove. This line exists to test the backend CI workflow.

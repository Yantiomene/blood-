{
  "name": "blood-",
  "version": "1.0.0",
  "description": "**Problem Statement:** 🆘",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "devStart": "nodemon server.js",
    "test": "echo \"Run tests in sub-projects (backend, client, frontend)\" && exit 1",
    "client:verify": "npm --prefix client run ci:verify",
    "backend:test": "npm --prefix backend test -- --runInBand --detectOpenHandles --verbose",
    "frontend:test": "CI=true npm --prefix frontend test -- --watchAll=false --passWithNoTests",
    "db:up": "docker compose -f backend/docker-compose.yml up -d",
    "db:down": "docker compose -f backend/docker-compose.yml down",
    "ci:verify-all": "npm run db:up && npm run backend:test && npm run client:verify && npm run frontend:test && npm run db:down"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "dotenv": "^16.4.4",
    "nodemon": "^3.0.3"
  }
}
